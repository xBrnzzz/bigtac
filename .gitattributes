# Keep text consistent across Windows and other development environments.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Image assets must remain binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
